{
  "name": "last-lantern",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "smoke": "node tools/smoke.mjs",
    "predev": "node tools/gen-model-manifest.mjs",
    "prebuild": "node tools/gen-model-manifest.mjs",
    "desktop": "electron electron/main.cjs",
    "package:icons": "node tools/package-icons.mjs",
    "package:web": "node tools/package-web.mjs --build --verify",
    "package:desktop": "node tools/package-desktop.mjs --build",
    "package:steam": "node tools/package-desktop.mjs --build --steam"
  },
  "dependencies": {
    "@fontsource/cinzel": "^5.3.0",
    "@fontsource/fredoka": "^5.3.0",
    "@fontsource/lilita-one": "^5.3.0",
    "@fontsource/nunito": "^5.3.0",
    "n8ao": "^1.9.4",
    "three": "0.170.0"
  },
  "devDependencies": {
    "@types/three": "0.170.0",
    "electron": "44.9.3",
    "electron-builder": "26.17.0",
    "typescript": "5.6.3",
    "vite": "5.4.11",
    "vitest": "2.1.8"
  }
}
